# Copy to .env and fill in real values.
# DATABASE_URL for local dev / Neon:
#   postgresql://USER:PASSWORD@HOST:5432/NEON_DATABASE_ID?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require"

# Secret used to sign JWT auth cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"