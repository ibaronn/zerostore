# Copy to .env and fill in real values.
# DATABASE_URL for local dev / Neon:
#   postgresql://USER:PASSWORD@HOST:5432/NEON_DATABASE_ID?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require"

# Secret used to sign JWT auth cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# OTP via WhatsApp — set BOTH values to send real messages through the WhatsApp Cloud API
# (Meta business phone number that has approved an OTP template with one {{1}} body parameter).
# If left unset, the site runs in demo mode and prints the code to the browser + server logs.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_TEMPLATE="otp_verification"
WHATSAPP_LANG="en"

# Optional pepper for hashing OTP codes (any long string; stable across restarts).
OTP_SECRET=""